{
  "entities": {
    "certificates": {
      "fields": {
        "id": { "type": "string", "description": "Unique Certificate ID, e.g. ORB-8F29K2" },
        "studentName": { "type": "string", "description": "Full name of recipient" },
        "course": { "type": "string", "description": "Course title" },
        "certificateNumber": { "type": "string", "description": "Institutional reference e.g. ORB/2026/FS-0142" },
        "dateIssued": { "type": "string", "description": "Issue date YYYY-MM-DD" },
        "courseDuration": { "type": "string", "description": "Length of program" },
        "certificateType": { "type": "string", "description": "Degree or certificate classification" },
        "studentId": { "type": "string", "description": "Student matriculation ID" },
        "additionalNotes": { "type": "string", "description": "Performance commendations or capstone summary" },
        "status": { "type": "string", "description": "valid or revoked" },
        "createdAt": { "type": "string", "description": "ISO timestamp of issuance" }
      }
    },
    "enrollments": {
      "fields": {
        "fullName": { "type": "string", "description": "Student applicant name" },
        "email": { "type": "string", "description": "Student email" },
        "phone": { "type": "string", "description": "Student phone number" },
        "courseId": { "type": "string", "description": "Course identifier" },
        "status": { "type": "string", "description": "pending or approved" },
        "createdAt": { "type": "string", "description": "Application timestamp" }
      }
    },
    "timetable": {
      "fields": {
        "id": { "type": "string", "description": "Unique timetable slot identifier" },
        "day": { "type": "string", "description": "Day of the week e.g. Monday, Tuesday" },
        "dayIndex": { "type": "number", "description": "1 to 6 representing Monday through Saturday" },
        "time": { "type": "string", "description": "Formatted time display e.g. 12:00–2:00 PM" },
        "startHour": { "type": "number", "description": "24hr start hour" },
        "startMinute": { "type": "number", "description": "Start minute (0-59)" },
        "endHour": { "type": "number", "description": "24hr end hour" },
        "endMinute": { "type": "number", "description": "End minute (0-59)" },
        "course": { "type": "string", "description": "Course or module title" },
        "instructor": { "type": "string", "description": "Instructor full name or handle" },
        "instructorTitle": { "type": "string", "description": "Instructor professional designation" },
        "venue": { "type": "string", "description": "Lab room or studio name" },
        "category": { "type": "string", "description": "Track category (security, development, creative, automation, engineering, data)" },
        "badge": { "type": "string", "description": "Optional focus badge or lab tag" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last update" }
      }
    },
    "articles": {
      "fields": {
        "id": { "type": "string", "description": "Unique article ID e.g. art-101" },
        "slug": { "type": "string", "description": "URL slug for article" },
        "title": { "type": "string", "description": "Article headline title" },
        "subtitle": { "type": "string", "description": "Brief summary or excerpt" },
        "content": { "type": "string", "description": "Full formatted markdown or HTML content" },
        "category": { "type": "string", "description": "Topic category e.g. Web Development, AI, Robotics" },
        "coverImage": { "type": "string", "description": "Hero banner image URL" },
        "readTime": { "type": "string", "description": "Estimated reading time e.g. 5 min read" },
        "status": { "type": "string", "description": "published or draft" },
        "publishedAt": { "type": "string", "description": "Publication date" },
        "deployedBy": { "type": "string", "description": "Name and role of publisher" },
        "authorType": { "type": "string", "description": "student or think-academy" },
        "thinkAcademyAuthor": { "type": "string", "description": "JSON string of Think Academy author profile (name, role, bio, institution)" },
        "studentAuthors": { "type": "string", "description": "JSON string of student author records and linked certificate IDs" },
        "supervisingTutor": { "type": "string", "description": "Supervising tutor name and designation" },
        "tags": { "type": "string", "description": "Comma-separated search tags" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Last update timestamp" }
      }
    },
    "attendance_classes": {
      "fields": {
        "id": { "type": "string", "description": "Unique class cohort ID" },
        "name": { "type": "string", "description": "Class title e.g. Full-Stack Web Development Cohort" },
        "code": { "type": "string", "description": "Class code e.g. FSWD-2026" },
        "category": { "type": "string", "description": "Subject track" },
        "scheduleDays": { "type": "array", "description": "Class meeting days" },
        "timeSlot": { "type": "string", "description": "Meeting time slot" },
        "venue": { "type": "string", "description": "Classroom or laboratory room" },
        "assignedTeacherIds": { "type": "array", "description": "Assigned instructors" }
      }
    },
    "attendance_sessions": {
      "fields": {
        "id": { "type": "string", "description": "Unique session ID" },
        "classId": { "type": "string", "description": "Referenced class ID" },
        "date": { "type": "string", "description": "Session date YYYY-MM-DD" },
        "sessionTopic": { "type": "string", "description": "Topic or module taught" },
        "studentAttendance": { "type": "object", "description": "Map of studentId to present/absent/late/excused" },
        "teacherAttendance": { "type": "object", "description": "Map of teacherId to present/absent" }
      }
    },
    "class_sessions": {
      "fields": {
        "class_session_id": { "type": "string", "description": "Unique class session identifier e.g. cybersecurity_cohort-3_2026-09-20" },
        "course": { "type": "string", "description": "Course title e.g. Cybersecurity" },
        "cohort": { "type": "string", "description": "Cohort number e.g. 3" },
        "date": { "type": "string", "description": "Session date YYYY-MM-DD" },
        "session_topic": { "type": "string", "description": "Topic covered in class session" },
        "student_attendance": { "type": "object", "description": "Map of student_id to attendance status" },
        "total_students": { "type": "number", "description": "Total students enrolled in cohort" },
        "present_count": { "type": "number", "description": "Count of present students" },
        "absent_count": { "type": "number", "description": "Count of absent students" },
        "late_count": { "type": "number", "description": "Count of late students" },
        "excused_count": { "type": "number", "description": "Count of excused students" },
        "updated_at": { "type": "string", "description": "ISO timestamp of last update" }
      }
    },
    "attendance_records": {
      "fields": {
        "id": { "type": "string", "description": "Compound key of class_session_id and student_id" },
        "class_session_id": { "type": "string", "description": "Referenced class session ID" },
        "student_id": { "type": "string", "description": "Referenced student ID" },
        "student_name": { "type": "string", "description": "Student full name" },
        "matric_number": { "type": "string", "description": "Matriculation reference" },
        "course": { "type": "string", "description": "Course title" },
        "cohort": { "type": "string", "description": "Cohort reference" },
        "date": { "type": "string", "description": "Session date" },
        "status": { "type": "string", "description": "present, absent, late, or excused" },
        "updated_at": { "type": "string", "description": "Timestamp of record entry" }
      }
    },
    "tutors": {
      "fields": {
        "id": { "type": "string", "description": "Unique tutor ID" },
        "slug": { "type": "string", "description": "Public URL slug for verification, e.g. lawal-frontend-lead" },
        "name": { "type": "string", "description": "Display name of tutor" },
        "role": { "type": "string", "description": "Faculty title or designation" },
        "specialization": { "type": "string", "description": "Primary domain focus" },
        "status": { "type": "string", "description": "active or deactivated" },
        "verificationStatus": { "type": "string", "description": "verified or pending" },
        "joinedDate": { "type": "string", "description": "Date joined faculty" }
      }
    },
    "programs": {
      "fields": {
        "id": { "type": "string", "description": "Unique program slug/ID" },
        "title": { "type": "string", "description": "Program full title" },
        "category": { "type": "string", "description": "Program domain track" },
        "status": { "type": "string", "description": "active, archived, or draft" },
        "duration": { "type": "string", "description": "Length of program" }
      }
    },
    "teaching_hours": {
      "fields": {
        "id": { "type": "string", "description": "Unique session ID" },
        "tutorId": { "type": "string", "description": "Foreign key to tutor ID" },
        "program": { "type": "string", "description": "Course program title" },
        "date": { "type": "string", "description": "Session date" },
        "durationHours": { "type": "number", "description": "Logged teaching duration in hours" },
        "topicCovered": { "type": "string", "description": "Topic or module" },
        "verificationStatus": { "type": "string", "description": "verified or pending" }
      }
    },
    "supervised_projects": {
      "fields": {
        "id": { "type": "string", "description": "Unique project identifier" },
        "verificationSlug": { "type": "string", "description": "Unique verification slug" },
        "title": { "type": "string", "description": "Project title" },
        "studentName": { "type": "string", "description": "Student author" },
        "program": { "type": "string", "description": "Program" },
        "tutorId": { "type": "string", "description": "Supervisor tutor ID" },
        "visibility": { "type": "string", "description": "public, private, or certificate-only" },
        "verificationStatus": { "type": "string", "description": "verified or pending" },
        "linkedCertificateId": { "type": "string", "description": "Linked student certificate ID" }
      }
    }
  },
  "relations": [],
  "security_rules": {
    "certificates": "Publicly readable by all users to allow instant employer credential verification; writable for administrative operations.",
    "enrollments": "Insertable by prospective learners during registration.",
    "timetable": "Publicly readable by all students and guests; writable and editable by administrators.",
    "tutors": "Publicly readable; writable by verified administrators.",
    "programs": "Publicly readable; writable by administrators.",
    "teaching_hours": "Publicly readable for verified totals; writable by administrators.",
    "supervised_projects": "Publicly readable for approved public projects; writable by tutors and admins.",
    "articles": "Publicly readable for published articles; writable by authorized administrators and sub-administrators.",
    "attendance_classes": "Readable and writable by super admin and sub admin.",
    "attendance_sessions": "Readable and writable by super admin and sub admin.",
    "class_sessions": "Readable by all students and tutors; writable only by administrators.",
    "attendance_records": "Readable by all students and tutors; writable only by administrators."
  }
}
